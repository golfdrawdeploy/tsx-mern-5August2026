# Mongo connection string. Local example:
MONGO_URI=mongodb://127.0.0.1:27017/star-wars-explorer

# Port the Express server listens on.
PORT=4000

# The client's origin - needed for CORS with credentials (cookies) to work.
CLIENT_ORIGIN=http://localhost:5173

# Secrets used to sign JWTs. Use long, random strings in real deployments.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret

# Token lifetimes.
# Access token is deliberately short so you can OBSERVE silent refresh happening.
ACCESS_TOKEN_TTL=60s
REFRESH_TOKEN_TTL=7d

# Demo/seed user credentials (hardcoded per assignment spec).
SEED_USERNAME=admin
SEED_PASSWORD=password123
